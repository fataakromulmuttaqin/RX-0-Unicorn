# ============================================
# RX-0 Unicorn — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit it.

# ─── Telegram Bot Configuration ───
# Get bot token from @BotFather on Telegram
# Send /newbot and follow instructions
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (user or group)
# Get it from @userinfobot or @get_id_bot
# Default: Home channel for Fataakromulm
TELEGRAM_CHAT_ID=633709469

# ─── Alert Settings ───
# Minimum time between alerts for the same pair (minutes)
ALERT_COOLDOWN_MINUTES=15

# Daemon scan interval (seconds)
SCAN_INTERVAL_SECONDS=300

# Number of top signals to send per scan cycle
ALERT_TOP_N=5

# ─── Exchange Configuration (Phase 7) ───
# Leave empty for now — Phase 4 doesn't need exchange keys
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# ─── Logging ───
# Set to DEBUG for verbose output, INFO for production
LOG_LEVEL=INFO
