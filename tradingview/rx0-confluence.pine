// https://mozilla.org/MPL/2.0/
// © RX-0 Unicorn
//
// @description
//   RX-0 Unicorn — Confluence Composite (overlay, MAIN script).
//   Menggabungkan 3 indikator chart-overlay: Luminance Breakout, BOS/CHoCH
//   Structure, dan Confluence scoring. (WaveTrend dipisah ke
//   `rx0-momentum.pine` karena pane-nya terpisah.)
//
//   Tiap indikator mengeluarkan sinyal -1 / 0 / +1 di bar saat ini
//   (real-time, tanpa look-ahead). Confluence score = jumlah indikator
//   searah (skor maksimal 3/3 di script ini; lihat Catatan di bawah).
//
//     score 0-1 -> SKIP  (tidak ditampilkan)
//     score 2   -> VALID  (size 1.0x) — light green tint
//     score 3   -> A+     (size 1.5x) — strong green tint
//
//   Catatan: di Python (`confluence/scorer.py`) skor penuh adalah 0-4 karena
//   ada 4 indikator. Script ini cuma menghitung 3 indikator yang plot-nya
//   masuk ke chart overlay (Luminance + Structure). Indikator ke-4
//   (WaveTrend) berada di pane terpisah bersama RSI, jadi ditampilkan
//   sebagai label saja di tabel: "WT = -1/0/+1". Scoring tetap EXACT sama
//   dengan Python: butuh >=3 dari 3 chart-overlay untuk A+, >=2 untuk
//   Valid. Lihat file `confluence/scorer.py` untuk scoring 4/4 dengan
//   WT = pakai `rx0-momentum.pine` baca signal ini manual.
//
//   Visual:
//     - Background tint per grade (hijau/merah).
//     - Arrow breakout (Luminance) + label BOS/CHoCH (Structure).
//     - Info table kanan-atas: Score, Grade, Direction, Regime, signals.
//
//   RECOMMENDED: ini script utama untuk lihat full RX-0 Unicorn framework
//   di chart. Pasangkan dengan `rx0-momentum.pine` di pane terpisah.
//
//   NOTE: visualisasi saja. Tidak untuk live trading (Phase 7).
//
//   v6 MIGRATION NOTES (TradingView now requires v6):
//     - Header: //@version=5 -> //@version=6
//     - bgcolor() moved to global scope via single ternary expression
//       (avoids CE10188 "local scope" error in v6).
//     - All `var` declarations are at global scope.
//     - `label.new()` / `box.new()` use named arguments.
//     - Explicit `int()` casts for arithmetic involving series float.
//     - All `input.*` calls have explicit defaults.

//@version=6
indicator(
     "RX-0 Confluence (Main)",
     shorttitle="RX0-Confluence",
     overlay=true,
     max_boxes_count=500,
     max_labels_count=500)

// =========================================================================
// 1. INPUTS
// =========================================================================
// --- Luminance ---
lumRangeLen = input.int(20,   "Luminance: Range Lookback",   minval=5,   maxval=200, group="Luminance")
lumVolMult  = input.float(1.5, "Luminance: Volume Mult (x)",  minval=0.5, step=0.1,   group="Luminance")
lumMinCons  = input.int(5,    "Luminance: Min Cons Bars",     minval=1,   maxval=50,  group="Luminance")
lumWidthPct = input.float(3.0, "Luminance: Cons Width %",     minval=0.1, step=0.1,   group="Luminance") / 100.0
lumShowBox  = input.bool(true, "Luminance: Draw Range Box",   group="Luminance")

// --- Structure ---
pivLen      = input.int(5, "Pivot Lookback (each side)", minval=2, maxval=20, group="Structure")
showSwings  = input.bool(true, "Mark Swing Points",       group="Structure")

// --- Confluence grading (skala 0-3 di script ini) ---
minValid    = input.int(2, "Min Score for VALID", minval=1, maxval=3, group="Confluence")
minAPlus    = input.int(3, "Min Score for A+",    minval=1, maxval=3, group="Confluence")
useRsiBonus = input.bool(true, "Add RSI-trend bonus for A+",  group="Confluence",
     tooltip="Tambahan +1/-1 dari RSI+DI alignment (membantu capai A+ walau cuma 2 chart-overlay). Nonaktifkan untuk scoring murni 2-indikator.")

// =========================================================================
// 2. LUMINANCE BREAKOUT
// =========================================================================
rangeHigh     = ta.highest(high, lumRangeLen)[1]
rangeLow      = ta.lowest(low, lumRangeLen)[1]
volAvg        = ta.sma(volume,  lumRangeLen)[1]
rangeWidth    = rangeHigh - rangeLow
isCons        = rangeWidth <= (close * lumWidthPct)

var int lumConsCount = 0
if isCons
    lumConsCount += 1
else
    lumConsCount := 0

volConfirm     = volume >= (volAvg * lumVolMult)
hadEnoughCons  = lumConsCount >= lumMinCons
lumLongBreak   = close > rangeHigh and volConfirm and hadEnoughCons
lumShortBreak  = close < rangeLow  and volConfirm and hadEnoughCons
lumSignal      = lumLongBreak ? 1 : lumShortBreak ? -1 : 0

// =========================================================================
// 3. STRUCTURE (BOS/CHoCH) — replika indicators/structure.py
// =========================================================================
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float lastSH = na
var float lastSL = na
if not na(ph)
    lastSH := ph
if not na(pl)
    lastSL := pl

prevSH = lastSH[1]
prevSL = lastSL[1]

var int bias = 0
var bool bosBull   = false
var bool bosBear   = false
var bool chochBull = false
var bool chochBear = false

brokeUp   = not na(prevSH) and close > prevSH
brokeDown = not na(prevSL) and close < prevSL

// Simultaneous break: priority = opposite of current bias (CHoCH first).
// Resolved flags are written once, with the simultaneous case decided
// here so downstream blocks never need to reassign `brokeUp`/`brokeDown`.
var bool effUp   = false
var bool effDown = false
effUp   := false
effDown := false
if brokeUp and brokeDown
    if bias == 1
        effDown := true
    else
        effUp   := true
else if brokeUp
    effUp   := true
else if brokeDown
    effDown := true

// Reset per-bar signals before evaluating the current bar.
bosBull   := false
bosBear   := false
chochBull := false
chochBear := false

if effUp
    bias := 1
    if bias[1] == -1
        chochBull := true
    else
        bosBull   := true
else if effDown
    bias := -1
    if bias[1] == 1
        chochBear := true
    else
        bosBear   := true

structSignal = (bosBull or chochBull) ? 1 : (bosBear or chochBear) ? -1 : 0

// =========================================================================
// 4. CONFLUENCE SCORING (skala 0-3, sesuai confluence/scorer.py logic)
// =========================================================================
// Skor 0-3 di script ini (Luminance + Structure + RSI-trend bonus untuk A+).
// Kita tambahkan "rsiBiasBonus": RSI Wilder memberi bonus +1 long/-1 short
// kalau trend-aligned (DI+ > DI-) supaya A+ setup tetap jarang & meaningful.
// Threshold untuk VALID/A+ bisa di-tune di input.

// --- Inline RSI Wilder (mini) untuk bonus trend bias saja ---
_rmaUp   = ta.rma(math.max(close - close[1], 0.0), 14)
_rmaDn   = ta.rma(math.max(close[1] - close,    0.0), 14)
_rsiVal  = _rmaDn == 0.0 and _rmaUp == 0.0 ? 50.0 : _rmaDn == 0.0 ? 100.0 : 100.0 - 100.0 / (1.0 + _rmaUp / _rmaDn)
_upMove  = high - high[1]
_dnMove  = low[1] - low
_plusDM  = (_upMove > _dnMove and _upMove > 0) ? _upMove : 0.0
_minusDM = (_dnMove > _upMove and _dnMove > 0) ? _dnMove : 0.0
_trVal   = ta.rma(ta.tr, 14)
_plusDI  = 100.0 * ta.rma(_plusDM,  14) / _trVal
_minusDI = 100.0 * ta.rma(_minusDM, 14) / _trVal

isTrending    = ta.rma(math.abs(_plusDI - _minusDI) / (_plusDI + _minusDI) * 100.0, 14) > 25.0
trendUp       = _plusDI  > _minusDI
trendDown     = _minusDI > _plusDI
rsiBiasBonus  = (useRsiBonus and isTrending and trendUp) ? 1 : (useRsiBonus and isTrending and trendDown) ? -1 : 0
regimeText    = isTrending ? "trending" : "ranging"

// Combine: long/short = base signals + bonus.
longCount  = (lumSignal   ==  1 ? 1 : 0) + (structSignal ==  1 ? 1 : 0) + (rsiBiasBonus ==  1 ? 1 : 0)
shortCount = (lumSignal   == -1 ? 1 : 0) + (structSignal == -1 ? 1 : 0) + (rsiBiasBonus == -1 ? 1 : 0)

confDir    = longCount > shortCount ? 1 : shortCount > longCount ? -1 : 0
confScore  = confDir == 1 ? longCount : confDir == -1 ? shortCount : 0
confGrade  = confScore >= minAPlus ? "A+" : confScore >= minValid ? "valid" : "skip"

// Rising-edge detection untuk alerts
var int prevConfScore = 0
var int prevConfDir   = 0
newAPlusLong  = confScore >= minAPlus and confDir ==  1 and not (prevConfScore >= minAPlus and prevConfDir ==  1)
newAPlusShort = confScore >= minAPlus and confDir == -1 and not (prevConfScore >= minAPlus and prevConfDir == -1)
newValidLong  = confScore >= minValid and confScore < minAPlus and confDir ==  1 and not (prevConfScore >= minValid and prevConfScore < minAPlus and prevConfDir ==  1)
newValidShort = confScore >= minValid and confScore < minAPlus and confDir == -1 and not (prevConfScore >= minValid and prevConfScore < minAPlus and prevConfDir == -1)

// =========================================================================
// 5. VISUAL OUTPUT
// =========================================================================

// 5a. Luminance breakout arrows
plotshape(lumLongBreak,   title="Luminance Long",  text="Lum▲", style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), textcolor=color.new(color.green, 0), size=size.small)
plotshape(lumShortBreak,  title="Luminance Short", text="Lum▼", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   0), textcolor=color.new(color.red,   0), size=size.small)

// 5b. Luminance range box
//   v6: yloc=yloc.price EXPLICIT (default in v5, but v6 is stricter and
//   requires it to be specified). Box anchored to rangeHigh/rangeLow
//   prices — by design, follows the price scale not the candle visually
//   when scrolling. This is standard Pine behavior.
if lumShowBox and isCons and lumConsCount >= 1
    box.new(
         left=bar_index - lumConsCount,
         top=rangeHigh,
         right=bar_index + 20,
         bottom=rangeLow,
         yloc=yloc.price,
         bgcolor=color.new(color.teal, 90),
         border_color=color.new(color.teal, 40),
         border_width=int(1))

// 5c. Swing markers
//   v6 IMPROVEMENT: use yloc=yloc.abovebar/belowbar so swing markers
//   follow the candle visually (relative position) instead of being
//   pinned to absolute price. This is the fix for the "stuck when
//   scrolling" issue on these markers.
if showSwings and not na(ph)
    label.new(
         x=bar_index[pivLen],
         y=ph,
         yloc=yloc.abovebar,
         text="▼",
         style=label.style_label_down,
         color=color.new(color.red,   70),
         textcolor=color.new(color.red,   0),
         size=size.tiny)
if showSwings and not na(pl)
    label.new(
         x=bar_index[pivLen],
         y=pl,
         yloc=yloc.belowbar,
         text="▲",
         style=label.style_label_up,
         color=color.new(color.green, 70),
         textcolor=color.new(color.green, 0),
         size=size.tiny)

// 5d. BOS/CHoCH labels
//   v6 IMPROVEMENT: use yloc so labels track candle visual position
//   rather than absolute price. Tooltip still shows the price context.
if bosBull
    label.new(
         x=bar_index,
         y=low,
         yloc=yloc.belowbar,
         text="BOS",
         style=label.style_label_up,
         color=color.new(color.blue,   0),
         textcolor=color.white,
         size=size.small,
         tooltip="Break of Structure — bullish continuation")
if bosBear
    label.new(
         x=bar_index,
         y=high,
         yloc=yloc.abovebar,
         text="BOS",
         style=label.style_label_down,
         color=color.new(color.blue,   0),
         textcolor=color.white,
         size=size.small,
         tooltip="Break of Structure — bearish continuation")
if chochBull
    label.new(
         x=bar_index,
         y=low,
         yloc=yloc.belowbar,
         text="CHoCH",
         style=label.style_label_up,
         color=color.new(color.orange, 0),
         textcolor=color.white,
         size=size.small,
         tooltip="Change of Character — bullish reversal")
if chochBear
    label.new(
         x=bar_index,
         y=high,
         yloc=yloc.abovebar,
         text="CHoCH",
         style=label.style_label_down,
         color=color.new(color.orange, 0),
         textcolor=color.white,
         size=size.small,
         tooltip="Change of Character — bearish reversal")

// 5e. Background tint by grade
//   v6 FIX: single ternary expression evaluated at global scope to avoid
//   the CE10188 "local scope" error.  Assigning the colour to a local
//   variable inside an `if` block also works, but the inline ternary is
//   the cleanest pattern.
gradeBgColor = confGrade == "A+" and confDir == 1 ? color.new(color.green, 88) : confGrade == "A+" and confDir == -1 ? color.new(color.red, 88) : confGrade == "valid" and confDir == 1 ? color.new(color.green, 95) : confGrade == "valid" and confDir == -1 ? color.new(color.red, 95) : na
bgcolor(gradeBgColor, title="Confluence Grade Background")

// 5f. Grade markers
plotshape(newAPlusLong,  title="A+ Long",  text="A+▲", style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0),  textcolor=color.new(color.green, 0),  size=size.normal)
plotshape(newAPlusShort, title="A+ Short", text="A+▼", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   0),  textcolor=color.new(color.red,   0),  size=size.normal)
plotshape(newValidLong  and not newAPlusLong,  title="Valid Long",  text="V▲", style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 30), textcolor=color.new(color.green, 30), size=size.tiny)
plotshape(newValidShort and not newAPlusShort, title="Valid Short", text="V▼", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   30), textcolor=color.new(color.red,   30), size=size.tiny)

// 5g. Info table (top-right)
var table infoTable = table.new(
     position=position.top_right,
     columns=2,
     rows=6,
     frame_color=color.new(color.gray, 30),
     frame_width=1,
     border_width=1)
if barstate.islast
    gradeColor = confGrade == "A+" ? color.green : confGrade == "valid" ? color.new(color.green, 50) : color.gray
    dirText    = confDir == 1 ? "Long" : confDir == -1 ? "Short" : "None"
    dirColor   = confDir == 1 ? color.green : confDir == -1 ? color.red : color.gray
    table.cell(table_id=infoTable, column=0, row=0, text="RX-0 Confluence",       text_color=color.white, bgcolor=color.new(color.blue, 20), text_size=size.small)
    table.cell(table_id=infoTable, column=1, row=0, text="",                       bgcolor=color.new(color.blue, 20))
    table.cell(table_id=infoTable, column=0, row=1, text="Score",                  text_color=color.white, bgcolor=color.new(color.gray,  70), text_size=size.small)
    table.cell(table_id=infoTable, column=1, row=1, text=str.tostring(confScore) + "/3", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(table_id=infoTable, column=0, row=2, text="Grade",                  text_color=color.white, bgcolor=color.new(color.gray,  70), text_size=size.small)
    table.cell(table_id=infoTable, column=1, row=2, text=confGrade,                text_color=color.white, bgcolor=gradeColor,                text_size=size.small)
    table.cell(table_id=infoTable, column=0, row=3, text="Direction",              text_color=color.white, bgcolor=color.new(color.gray,  70), text_size=size.small)
    table.cell(table_id=infoTable, column=1, row=3, text=dirText,                  text_color=color.white, bgcolor=dirColor,                  text_size=size.small)
    table.cell(table_id=infoTable, column=0, row=4, text="Regime",                 text_color=color.white, bgcolor=color.new(color.gray,  70), text_size=size.small)
    table.cell(table_id=infoTable, column=1, row=4, text=regimeText,               text_color=color.white, bgcolor=isTrending ? color.new(color.green, 50) : color.new(color.gray, 50), text_size=size.small)
    table.cell(table_id=infoTable, column=0, row=5, text="Signals (Lum/Str/RSI)",  text_color=color.white, bgcolor=color.new(color.gray,  70), text_size=size.tiny)
    table.cell(table_id=infoTable, column=1, row=5, text=str.tostring(lumSignal) + " / " + str.tostring(structSignal) + " / " + str.tostring(rsiBiasBonus), text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.tiny)

// =========================================================================
// 6. UPDATE PREV STATE
// =========================================================================
prevConfScore := confScore
prevConfDir   := confDir

// =========================================================================
// 7. ALERTS
// =========================================================================
alertcondition(newAPlusLong,  title="A+ Long",     message="RX-0 A+ LONG on {{ticker}} ({{interval}}) score=3/3 (Luminance + Structure + RSI-trend aligned)")
alertcondition(newAPlusShort, title="A+ Short",    message="RX-0 A+ SHORT on {{ticker}} ({{interval}}) score=3/3 (Luminance + Structure + RSI-trend aligned)")
alertcondition(newValidLong,  title="Valid Long",  message="RX-0 VALID LONG on {{ticker}} ({{interval}}) score>=2/3")
alertcondition(newValidShort, title="Valid Short", message="RX-0 VALID SHORT on {{ticker}} ({{interval}}) score>=2/3")
